MAX_BOT_TOKEN=
# polling: local development; webhook: production
MAX_UPDATE_MODE=polling
# For webhook mode (public HTTPS, port 443, reverse proxy to MAX_LISTEN_ADDR):
MAX_WEBHOOK_URL=https://example.com/max/webhook
MAX_WEBHOOK_SECRET=replace_with_random_secret
MAX_LISTEN_ADDR=127.0.0.1:8080
# MAX_API_URL=https://platform-api2.max.ru
# SSL_CERT_FILE=/path/to/ca-bundle-including-minцифры.pem

LOG_LEVEL=INFO

# PostgreSQL connection (in Kubernetes, inject through Secret)
DATABASE_URL=postgres://rzd_monitor:change_me@localhost:5432/rzd_monitor?sslmode=disable
